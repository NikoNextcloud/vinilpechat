{
  "version": 2,
  "framework": null,
  "buildCommand": "npm run build",
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/index?route=seo/sitemap"
    },
    {
      "source": "/teniski/:slug(.*-model-ST[0-9]{4})",
      "destination": "/api/index?route=seo/shirt&slug=:slug"
    },
    {
      "source": "/produkti/:slug",
      "destination": "/api/index?route=seo/product&slug=:slug"
    },
    {
      "source": "/kategorii/:slug",
      "destination": "/api/index?route=seo/category&slug=:slug"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index?route=:path*"
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "public/teniski/index.html"
    }
  },
  "git": {
    "deploymentEnabled": {
      "feature/vinilpechat-2-0-drag-only": false
    }
  }
}
