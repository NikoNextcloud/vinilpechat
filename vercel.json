{
  "version": 2,
  "framework": null,
  "buildCommand": "npm run build",
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:section(nov-vinil|brezenti|teniski|pechatni-produkti|kontakti|zapitvane)",
      "destination": "/:section/",
      "permanent": true
    },
    {
      "source": "/:section(nov-vinil|brezenti|teniski|pechatni-produkti|kontakti|zapitvane)/index.html",
      "destination": "/:section/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/index?route=seo/sitemap"
    },
    {
      "source": "/teniski/:slug(.*-model-ST[0-9]{4})/",
      "destination": "/api/index?route=seo/shirt&slug=:slug&trailing=1"
    },
    {
      "source": "/teniski/:slug(.*-model-ST[0-9]{4})",
      "destination": "/api/index?route=seo/shirt&slug=:slug"
    },
    {
      "source": "/produkti/:slug/",
      "destination": "/api/index?route=seo/product&slug=:slug&trailing=1"
    },
    {
      "source": "/produkti/:slug",
      "destination": "/api/index?route=seo/product&slug=:slug"
    },
    {
      "source": "/kategorii/:slug/",
      "destination": "/api/index?route=seo/category&slug=:slug&trailing=1"
    },
    {
      "source": "/kategorii/:slug",
      "destination": "/api/index?route=seo/category&slug=:slug"
    },
    {
      "source": "/pechatni-produkti/:slug(vp4-[0-9]{3}-[a-z0-9-]+)/",
      "destination": "/api/index?route=seo/print-service&slug=:slug&trailing=1"
    },
    {
      "source": "/pechatni-produkti/:slug(vp4-[0-9]{3}-[a-z0-9-]+)",
      "destination": "/api/index?route=seo/print-service&slug=:slug"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index?route=:path*"
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "public/teniski/index.html"
    }
  }
}
